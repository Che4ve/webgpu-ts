/**
 * ============================================================================
 * SHADOW PASS VERTEX SHADER
 * ============================================================================
 * 
 * Этот шейдер используется для ПЕРВОГО прохода рендеринга (Shadow Pass).
 * Его задача - записать глубину (depth) каждого пикселя сцены с точки зрения
 * направленного источника света.
 * 
 * ЗАЧЕМ ЭТО НУЖНО:
 * Shadow Mapping работает в 2 этапа:
 * 1) Рендерим сцену "глазами света" и сохраняем глубину в текстуру (shadow map)
 * 2) При обычном рендеринге сравниваем глубину пикселя с shadow map
 * 
 * Если пиксель дальше от света, чем записано в shadow map - значит он в тени!
 * 
 * ВАЖНО: Этот шейдер НЕ ВЫВОДИТ ЦВЕТ (нет fragment shader).
 * WebGPU автоматически записывает gl_Position.z в depth buffer.
 */

/**
 * Структура uniform-данных для shadow pass.
 * Содержит матрицы для трансформации вершин.
 */
struct ShadowUniforms {
  /**
   * lightViewProj = lightProjection * lightView
   * 
   * Это комбинированная матрица, которая преобразует координаты из
   * мирового пространства в clip space "глазами источника света".
   * 
   * lightView - матрица вида (lookAt) из позиции света
   * lightProjection - ортографическая проекция (для направленного света)
   */
  lightViewProj : mat4x4<f32>,
  
  /**
   * model - матрица модели объекта
   * Преобразует локальные координаты вершины в мировые координаты.
   * Включает: translation (перемещение), rotation (вращение), scale (масштаб)
   */
  model : mat4x4<f32>,
};

// Биндинг uniform буфера на группу 0, слот 0
// @group(0) - номер bind group (у нас только одна группа для shadow pass)
// @binding(0) - номер слота внутри группы
@group(0) @binding(0) var<uniform> shadow : ShadowUniforms;

/**
 * Входные данные вершины (из vertex buffer).
 * @location соответствует shaderLocation в vertexBufferLayout в main.ts
 */
struct VSIn {
  @location(0) position : vec3<f32>,  // Позиция вершины в локальных координатах
  @location(1) normal : vec3<f32>,    // Нормаль (не используется, но должна быть в layout)
  @location(2) uv : vec2<f32>,        // Текстурные координаты (не используются)
};

/**
 * Главная функция vertex shader.
 * 
 * @param input - данные вершины из vertex buffer
 * @return - позиция в clip space (используется для записи depth)
 * 
 * @builtin(position) - специальный вывод, который WebGPU использует для:
 *   1) Определения позиции пикселя на экране (x, y)
 *   2) Записи глубины в depth buffer (z)
 */
@vertex
fn main(input : VSIn) -> @builtin(position) vec4<f32> {
  // Шаг 1: Преобразуем позицию вершины из локальных координат в мировые
  // shadow.model содержит трансформации объекта (поворот, масштаб, перемещение)
  let worldPos = shadow.model * vec4<f32>(input.position, 1.0);
  
  // Шаг 2: Преобразуем мировые координаты в clip space источника света
  // lightViewProj = projection * view (матрица "камеры" с позиции света)
  // 
  // После этого преобразования:
  // - x, y будут в диапазоне [-1, 1] (нормализованные координаты экрана)
  // - z будет в диапазоне [0, 1] (глубина, где 0 = близко, 1 = далеко)
  // 
  // Именно z будет записан в shadow map!
  return shadow.lightViewProj * worldPos;
}
