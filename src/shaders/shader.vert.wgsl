/**
 * ============================================================================
 * MAIN VERTEX SHADER (для куба)
 * ============================================================================
 * 
 * Этот шейдер используется для ВТОРОГО прохода рендеринга (Main Pass).
 * Он преобразует вершины и передаёт данные во fragment shader для
 * расчёта освещения и теней.
 * 
 * VERTEX SHADER выполняется для каждой вершины геометрии.
 * Его главные задачи:
 * 1) Преобразовать позицию вершины в экранные координаты
 * 2) Подготовить данные для fragment shader (позиция, нормаль, UV, shadowPos)
 */

// ============================================================================
// СТРУКТУРЫ ДАННЫХ
// ============================================================================

/**
 * Ambient (окружающее) освещение.
 * Это базовый уровень света, который есть везде (имитирует отражённый свет).
 * Без него объекты в тени были бы полностью чёрными.
 */
struct Ambient {
  color : vec3<f32>,      // RGB цвет ambient света (обычно белый или тёплый)
  intensity : f32,        // Интенсивность (0.0 - 1.0)
};

/**
 * Directional (направленный) источник света.
 * Имитирует солнце - все лучи параллельны, нет затухания с расстоянием.
 * ИМЕННО ОТ НЕГО МЫ ДЕЛАЕМ ТЕНИ!
 */
struct Directional {
  direction : vec3<f32>,  // Направление лучей света (нормализованный вектор)
  intensity : f32,        // Интенсивность света
  color : vec3<f32>,      // RGB цвет света
  _pad : f32,             // Паддинг для выравнивания (WGSL требует 16-байтное выравнивание)
};

/**
 * Материал поверхности.
 * Определяет, как поверхность взаимодействует со светом.
 */
struct Material {
  albedo : vec3<f32>,     // Базовый цвет поверхности (модулирует текстуру)
  shininess : f32,        // Блеск (чем больше - тем меньше и ярче блик)
  specular : vec3<f32>,   // Цвет бликов (обычно белый)
  _pad : f32,             // Паддинг для выравнивания
};

/**
 * ShadowData - данные для shadow mapping.
 * Вынесены в отдельную структуру и bind group, чтобы не менять
 * размер основного uniform buffer (это упрощает код).
 */
struct ShadowData {
  /**
   * lightViewProj - та же матрица, что и в shadow.vert.wgsl
   * Нужна для преобразования позиции вершины в пространство света,
   * чтобы потом сравнить глубину с shadow map.
   */
  lightViewProj : mat4x4<f32>,
};

/**
 * Scene - главная структура с данными сцены.
 * Передаётся из JavaScript через uniform buffer.
 */
struct Scene {
  projection : mat4x4<f32>,   // Матрица проекции камеры (перспектива)
  view : mat4x4<f32>,         // Матрица вида камеры (позиция и направление взгляда)
  model : mat4x4<f32>,        // Матрица модели (трансформации объекта)
  cameraPos : vec3<f32>,      // Позиция камеры в мировых координатах
  _padCam : f32,              // Паддинг
  ambient : Ambient,          // Ambient освещение
  directional : Directional,  // Направленный источник света
  material : Material,        // Материал поверхности
  pointLightCount : f32,      // Количество активных точечных источников
  _padLights : vec3<f32>,     // Паддинг (vec3 требует 16-байтное выравнивание!)
};

// ============================================================================
// БИНДИНГИ (связь с JavaScript)
// ============================================================================

// Group 0: основные данные сцены
@group(0) @binding(0) var<uniform> scene : Scene;

// Group 1: данные для теней (отдельная группа для гибкости)
@group(1) @binding(0) var<uniform> shadowData : ShadowData;

// ============================================================================
// ВХОДНЫЕ И ВЫХОДНЫЕ ДАННЫЕ
// ============================================================================

/**
 * Входные данные вершины из vertex buffer.
 * Атрибуты соответствуют тому, как мы упаковали данные в JavaScript.
 */
struct VSIn {
  @location(0) position : vec3<f32>,  // Позиция в локальных координатах объекта
  @location(1) normal   : vec3<f32>,  // Нормаль поверхности (для освещения)
  @location(2) uv       : vec2<f32>,  // Текстурные координаты
};

/**
 * Выходные данные вершины → передаются во fragment shader.
 * Fragment shader получит ИНТЕРПОЛИРОВАННЫЕ значения между вершинами!
 */
struct VSOut {
  @builtin(position) position : vec4<f32>,  // Позиция на экране (clip space)
  @location(0) worldPos       : vec3<f32>,  // Позиция в мировых координатах
  @location(1) normal         : vec3<f32>,  // Нормаль в мировых координатах
  @location(2) uv             : vec2<f32>,  // Текстурные координаты
  @location(3) shadowPos      : vec4<f32>,  // Позиция в пространстве света (для теней!)
};

// ============================================================================
// ГЛАВНАЯ ФУНКЦИЯ
// ============================================================================

@vertex
fn main(input : VSIn) -> VSOut {
  var out : VSOut;
  
  // ========================================
  // ШАГ 1: Преобразование координат
  // ========================================
  
  // Добавляем w=1.0 для аффинных преобразований (перемещение работает только с w=1)
  let point = vec4<f32>(input.position, 1.0);
  
  // Локальные → Мировые координаты
  // model содержит: Translation * Rotation * Scale
  let worldPos = scene.model * point;
  
  // Мировые → Координаты камеры (view space)
  let viewPos = scene.view * worldPos;
  
  // View space → Clip space (экранные координаты с глубиной)
  // После projection: x,y ∈ [-1,1], z ∈ [0,1]
  out.position = scene.projection * viewPos;
  
  // Сохраняем мировую позицию для расчёта освещения в fragment shader
  out.worldPos = worldPos.xyz;

  // ========================================
  // ШАГ 2: Позиция для Shadow Mapping
  // ========================================
  
  // Преобразуем мировую позицию в пространство источника света.
  // Эта позиция будет использоваться во fragment shader для
  // сравнения глубины с shadow map.
  // 
  // shadowPos.xyz / shadowPos.w даст нам координаты в NDC света
  // shadowPos.z / shadowPos.w - глубина пикселя "с точки зрения света"
  out.shadowPos = shadowData.lightViewProj * worldPos;

  // ========================================
  // ШАГ 3: Преобразование нормали
  // ========================================
  
  // ПРОБЛЕМА: Если объект масштабирован неравномерно (например, сплющен),
  // то нормали "поедут" и освещение будет неправильным.
  // 
  // РЕШЕНИЕ: Нормаль нужно преобразовывать через обратную транспонированную
  // матрицу: N' = (M^-1)^T * N. Но это дорого вычислять.
  // 
  // ОПТИМИЗАЦИЯ: Мы извлекаем масштаб из матрицы модели и корректируем нормаль.
  
  // Извлекаем столбцы матрицы модели (это оси X, Y, Z после трансформации)
  let c0 = scene.model[0].xyz;  // Ось X
  let c1 = scene.model[1].xyz;  // Ось Y
  let c2 = scene.model[2].xyz;  // Ось Z

  // Длины столбцов = масштабы по осям
  // max(..., 1e-8) защищает от деления на ноль
  let sx = max(length(c0), 1e-8);
  let sy = max(length(c1), 1e-8);
  let sz = max(length(c2), 1e-8);

  // Нормализуем столбцы → получаем чистую матрицу вращения R
  let r0 = c0 / sx;
  let r1 = c1 / sy;
  let r2 = c2 / sz;
  let R  = mat3x3<f32>(r0, r1, r2);

  // Корректируем нормаль: делим на масштаб, затем вращаем
  // N' = normalize(R * (N / S))
  let Nobj = input.normal / vec3<f32>(sx, sy, sz);
  out.normal = normalize(R * Nobj);

  // Просто копируем UV координаты
  out.uv = input.uv;
  
  return out;
}
